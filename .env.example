APP_NAME="Altesa Panel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Istanbul
APP_URL=http://localhost

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

LOG_CHANNEL=stack
LOG_LEVEL=debug

BROADCAST_CONNECTION=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Company Settings
COMPANY_NAME="Altesa"
COMPANY_ADDRESS=""
COMPANY_PHONE=""
COMPANY_EMAIL="info@altesa.com"
COMPANY_TAX_NUMBER=""
COMPANY_TAX_OFFICE=""

# Uploads
MAX_UPLOAD_SIZE=10240
